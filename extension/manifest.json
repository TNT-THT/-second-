{
  "manifest_version": 3,
  "name": "桌边 · 洛谷小花",
  "description": "仅在手动配对后，向本机桌宠发送前台洛谷在场信号与通过题号。",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.luogu.com.cn/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "pair.html"
  }
}
